# ORIGIN that serves CrisprTechApp (the /parent/*.php APIs live there). No path.
# Leave unset to auto-pick: localhost -> http://127.0.0.1:8099, else https://crisprtech.app
VITE_API_BASE=http://127.0.0.1:8099

# Demo mode renders the whole portal from src/data/parentPortalDemo.js and
# accepts OTP 1234 for any 10-digit mobile. Off by default; set to 1 to
# demo without a backend.
VITE_DEMO_MODE=0
