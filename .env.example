# Base URL that serves the CrisprTechApp /parent/*.php APIs: the origin plus
# any path prefix CrisprTechApp is mounted under, without a trailing slash.
# Leave unset to auto-pick:
#   localhost -> http://127.0.0.1:8099            (php -S serves CrisprTechApp at the root)
#   else      -> https://crisprtech.app/crispr-apis
VITE_API_BASE=http://127.0.0.1:8099

# Demo mode renders the whole portal from src/data/parentPortalDemo.js and
# accepts OTP 1234 for any 10-digit mobile. Off by default; set to 1 to
# demo without a backend.
VITE_DEMO_MODE=0
